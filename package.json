{
  "name": "testes-projetos-academicos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:api": "playwright test --config playwright.api.config.ts",
    "test:api:dev": "cross-env TEST_ENV=dev TEST_BASE_URL=https://projetosacademicos-dev.ufg.br playwright test --config playwright.api.config.ts",
    "test:api:homolog": "cross-env TEST_ENV=homolog TEST_BASE_URL=https://projetosacademicos-homolog.ufg.br playwright test --config playwright.api.config.ts",
    "report:api": "playwright show-report playwright-report/api",
    "test": "playwright test",
    "test:dev": "cross-env TEST_ENV=dev TEST_BASE_URL=https://projetosacademicos-dev.ufg.br playwright test",
    "test:homolog": "cross-env TEST_ENV=homolog TEST_BASE_URL=https://projetosacademicos-homolog.ufg.br playwright test",
    "test:dev:headed": "cross-env TEST_ENV=dev TEST_BASE_URL=https://projetosacademicos-dev.ufg.br playwright test --headed",
    "test:homolog:headed": "cross-env TEST_ENV=homolog TEST_BASE_URL=https://projetosacademicos-homolog.ufg.br playwright test --headed",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
